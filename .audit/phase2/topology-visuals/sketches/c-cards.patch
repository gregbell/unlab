diff --git a/src/ui/desktop/topology.css b/src/ui/desktop/topology.css
index 728eed8..8084982 100644
--- a/src/ui/desktop/topology.css
+++ b/src/ui/desktop/topology.css
@@ -212,4 +212,41 @@
 			font-size: 12px;
 		}
 	}
+	/* Sketch C: each node a card, its name beside its art, as a row of the rack has it. */
+	.n-column {
+		align-items: stretch;
+	}
+	.n-node {
+		grid-auto-flow: column;
+		justify-content: start;
+		align-items: center;
+		column-gap: 9px;
+		padding: 6px 12px 6px 6px;
+		background: var(--mantle);
+		border: 1px solid var(--line);
+		text-align: left;
+	}
+	.n-node:is(:hover, :focus-visible) {
+		background: var(--base);
+	}
+	.n-node[data-selected="true"] {
+		border-color: var(--machine-hue, var(--agent));
+		background: color-mix(in srgb, var(--machine-hue, var(--agent)) 12%, var(--mantle));
+	}
+	.n-node .n-tile {
+		width: 52px;
+		height: 30px;
+		border: 0;
+		background: none;
+	}
+	.n-node .n-tile .n-art {
+		transform: scale(0.78);
+	}
+	.n-node-label {
+		justify-items: start;
+		max-width: 150px;
+	}
+	.n-drawing {
+		--n-gap: 12px;
+	}
 }
