>    {
>     "term": "[--loss percent]",
>     "text": "The share of frames that the cable loses, in each direction: 20%, or 0.5%. 0 takes the loss away."
>    },
>    {
>     "term": "[--reorder percent]",
>     "text": "The share of frames that skip the delay, and so arrive ahead of those sent before them: 25%. It needs a delay. 0 takes it away."
>    },
>    {
>     "term": "[--rate rate]",
>     "text": "The most the cable carries each way, in bits a second: 1mbit, 500kbit. A frame that would wait behind 64 KiB is dropped. 0 takes the rate away."
